[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "xtquant-big-convert-client"
version = "@VERSION@"
description = "Big QMT RPC client without the top-level xtquant compatibility shim"
readme = "README.md"
requires-python = ">=3.8"
license = {text = "MIT"}
authors = [
    {name = "litaolemo"},
]
dependencies = [
    "pyzmq>=25.0.0",
]

[project.optional-dependencies]
redis = ["redis>=5.0.0"]
mysql = ["pymysql>=1.0.0", "DBUtils>=3.0.0"]
msgpack = ["msgpack>=1.0.0"]

[project.urls]
Homepage = "https://github.com/alexzlx1900/xtquant_big_convert"
Repository = "https://github.com/alexzlx1900/xtquant_big_convert.git"

[tool.setuptools]
package-dir = {"" = "src"}

[tool.setuptools.packages.find]
where = ["src"]
include = ["bigqmt_signal_trader*"]

[tool.setuptools.package-data]
bigqmt_signal_trader = ["*.md"]
